<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the tool's own target framework; the CLI is not multi-targeted. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit discovers collection definitions by reflection, so they must stay public. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Xping.Cli\Xping.Cli.csproj" />
    <ProjectReference Include="..\..\src\Xping.Sdk.XUnit\Xping.Sdk.XUnit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The recorded failure text lives with the normaliser it was collected for; the CLI's
         signature tests use the same samples. -->
    <Compile Include="..\Xping.Sdk.Core.Tests\Diagnostics\RealFailureSamples.cs" Link="Report\RealFailureSamples.cs" />
  </ItemGroup>

</Project>
