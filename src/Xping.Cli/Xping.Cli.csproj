<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>

    <!-- Packaged as a .NET tool. The documented install is global (`dotnet tool install -g`),
         which puts an `xping` command on PATH - the name every command the tool prints uses.
         A tool-manifest install still works and is invoked as `dotnet xping`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xping</ToolCommandName>

    <!-- System.CommandLine takes the root command's displayed name from the entry assembly, so
         without this the tool's help output would print `Usage: Xping.Cli [command]` - a name
         the user cannot type. The package is still Xping.Cli; only the assembly file is renamed,
         so pin RootNamespace to keep new files defaulting to the Xping.Cli namespace. -->
    <AssemblyName>xping</AssemblyName>
    <RootNamespace>Xping.Cli</RootNamespace>

    <PackageId>Xping.Cli</PackageId>
    <Description>Command-line companion for the Xping SDK. Reads the local run store written by Xping.Sdk.Core and reports test flakiness from recent local runs. No account required.</Description>
    <PackageTags>testing;observability;flaky-tests;reliability;cli;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\media\icon.png" Pack="true" PackagePath="\" />
    <!-- The CLI has its own NuGet readme; the shared one describes installing SDK adapters,
         which is not what someone landing on this package is looking for. -->
    <None Include="..\..\nuspec\README.Cli.md" Pack="true" PackagePath="\README.md" />
    <None Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xping.Sdk.Core\Xping.Sdk.Core.csproj" />
    <ProjectReference Include="..\Xping.Sdk.Shared\Xping.Sdk.Shared.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Xping.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
