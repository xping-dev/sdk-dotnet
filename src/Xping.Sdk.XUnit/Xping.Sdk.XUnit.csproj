<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- NuGet Package Metadata -->
    <PackageId>Xping.Sdk.XUnit</PackageId>
    <Description>For xUnit v2 (the xunit package, 2.x). Using xUnit v3 (the xunit.v3 package)? Use Xping.Sdk.XUnit.V3 instead. xUnit v2 adapter for Xping SDK - records every test execution through a custom test framework.</Description>
    <PackageTags>$(PackageTags);xunit</PackageTags>
    <PackageReleaseNotes>Initial release of Xping SDK xUnit adapter with support for custom test framework integration, automatic tracking of [Fact] and [Theory] tests, and environment detection.</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Include icon and README in the package -->
  <ItemGroup>
    <None Include="..\..\docs\media\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\nuspec\README.md" Pack="true" PackagePath="\" />
    <None Update="buildTransitive\Xping.Sdk.XUnit.targets" Pack="true" PackagePath="buildTransitive\Xping.Sdk.XUnit.targets" />
    <None Remove="obj\**" />
  </ItemGroup>
  
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Xping.Sdk.XUnit.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xping.Sdk.Core\Xping.Sdk.Core.csproj" />
    <ProjectReference Include="..\Xping.Sdk.Shared\Xping.Sdk.Shared.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.extensibility.core" Version="2.9.2" />
    <PackageReference Include="xunit.extensibility.execution" Version="2.9.2" />
  </ItemGroup>

</Project>
