<Project>
  <!--
    Stops the build of a project that pairs this adapter with xUnit v3. The adapter brings in xUnit v2's
    xunit.core, which defines the same Xunit types as xunit.v3.core, so the build would otherwise fail
    on every [Fact] with CS0433 and never mention the package that caused it.

    Reads the resolved references rather than the PackageReference items, so a version set by central
    package management or a reference that arrives transitively is caught too.
  -->
  <Target Name="_XpingCheckXUnitVersion" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile">
    <Error Code="XPING001"
           Text="Xping.Sdk.XUnit supports xUnit v2, but this project references xUnit v3 (xunit.v3). Replace it with Xping.Sdk.XUnit.V3."
           Condition="'@(ReferencePath->WithMetadataValue('Filename', 'xunit.v3.core'))' != ''" />
  </Target>
</Project>
