<Project>
    <!-- Import parent Directory.Build.props -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <!-- Keep documentation generation enabled to satisfy IDE0005 analyzer -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Sample projects should not be packable -->
        <IsPackable>false</IsPackable>

        <!-- Suppress documentation and API visibility warnings for sample projects -->
        <!-- CA5394: Random is acceptable for non-security flaky-test simulation in samples -->
        <NoWarn>$(NoWarn);CA2007;CS1591;CA1515;CA1816;CA1062;CA5394</NoWarn>

        <!-- Allow some relaxed rules for samples -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    </PropertyGroup>

    <!--
        -p:XpingTestRunner=MTP runs the NUnit, MSTest and xUnit v3 samples on Microsoft.Testing.Platform
        instead of vstest. xUnit v2 has no MTP runner, so its sample stays on vstest. The xUnit v3
        sample swaps its own packages; see its project file.

        An MTP build gets its own bin/ and obj/: its restore pulls different packages, and the run
        tests build both flavours of the same sample. Its obj/mtp/ sits inside obj/, which the vstest
        build already leaves out of its globs; the MTP build has to leave out the vstest obj/ in turn.
    -->
    <PropertyGroup Condition="'$(XpingTestRunner)' == 'MTP' AND '$(MSBuildProjectName)' != 'SampleApp.XUnit'">
        <OutputType>Exe</OutputType>
        <EnableNUnitRunner>true</EnableNUnitRunner>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <BaseOutputPath>bin/mtp/</BaseOutputPath>
        <BaseIntermediateOutputPath>obj/mtp/</BaseIntermediateOutputPath>
        <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup Condition="'$(XpingTestRunner)' == 'MTP' AND ('$(MSBuildProjectName)' == 'SampleApp.NUnit' OR '$(MSBuildProjectName)' == 'SampleApp.MSTest')">
        <!-- Matches the Microsoft.Testing.Platform 1.9 that both runners ship with; enables report-trx. -->
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
    </ItemGroup>

    <!--
        -p:XpingSkipAssemblyCleanup=true builds the MSTest sample without its [AssemblyCleanup], so the
        run tests reach the SDK's process-exit safety net.
    -->
    <PropertyGroup Condition="'$(XpingSkipAssemblyCleanup)' == 'true'">
        <DefineConstants>$(DefineConstants);XPING_SKIP_ASSEMBLY_CLEANUP</DefineConstants>
    </PropertyGroup>

    <!--
        -p:XpingSampleWithoutAssemblyInfo=true builds a sample without generated assembly info, which
        drops its Xping.ProjectPath stamp. A plain -p:GenerateAssemblyInfo=false would reach the SDK
        projects the sample references too, and fail their build.
    -->
    <PropertyGroup Condition="'$(XpingSampleWithoutAssemblyInfo)' == 'true'">
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>
</Project>
